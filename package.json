{
  "name": "agent-enterprise-protocol",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "openapi:bundle": "redocly bundle openapi/aep-v1-m0.openapi.yaml -o openapi/dist/aep-v1-m0.bundle.yaml",
    "openapi:lint": "redocly lint openapi/aep-v1-m0.openapi.yaml",
    "openapi:types": "openapi-typescript openapi/dist/aep-v1-m0.bundle.yaml -o packages/aep-sdk-node/src/generated/aep-v1.ts",
    "openapi:build": "npm run openapi:bundle && npm run openapi:types",
    "build": "npm run openapi:build && npm run build --workspaces --if-present",
    "test": "npm run openapi:bundle && npm run test --workspaces --if-present",
    "test:e2e": "node tests/e2e/m0.mjs",
    "compose:up": "docker compose -f deploy/compose/compose.yaml up -d --build",
    "compose:down": "docker compose -f deploy/compose/compose.yaml down",
    "check": "npm run openapi:lint && npm run build && npm test"
  },
  "devDependencies": {
    "@redocly/cli": "^2.6.0",
    "openapi-typescript": "^7.10.1"
  }
}
