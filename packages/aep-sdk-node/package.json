{
  "name": "@aep/sdk-node",
  "version": "0.2.6",
  "description": "Node.js SDK for Agent Enterprise Protocol",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rongxinzy/Agent-Enterprise-Protocol.git",
    "directory": "packages/aep-sdk-node"
  },
  "homepage": "https://github.com/rongxinzy/Agent-Enterprise-Protocol/tree/main/packages/aep-sdk-node#readme",
  "bugs": {
    "url": "https://github.com/rongxinzy/Agent-Enterprise-Protocol/issues"
  },
  "keywords": ["aep", "agent", "enterprise", "protocol"],
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md", "README.zh-CN.md"],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {"node": ">=24 <25"},
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
