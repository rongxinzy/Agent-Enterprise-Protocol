AEP_ENVIRONMENT=production
AEP_LOG_FORMAT=json
AEP_LOG_LEVEL=info
AEP_GATEWAY_ADDRESS=:8090
AEP_GATEWAY_UPSTREAM_URL=http://higress-gateway.higress-system.svc.cluster.local:80
AEP_GATEWAY_JWKS_URL=http://aep-control.aep-system.svc.cluster.local:8080/.well-known/jwks.json
AEP_GATEWAY_ISSUER=https://aep.example.com
AEP_GATEWAY_JWKS_TTL=5m
AEP_GATEWAY_JWKS_TIMEOUT=2s
AEP_GATEWAY_REQUEST_LIMIT=2097152
AEP_GATEWAY_HTTP_READ_HEADER_TIMEOUT=5s
AEP_GATEWAY_HTTP_READ_TIMEOUT=15s
# Zero preserves long-lived model streaming responses.
AEP_GATEWAY_HTTP_WRITE_TIMEOUT=0s
AEP_GATEWAY_HTTP_IDLE_TIMEOUT=60s
AEP_GATEWAY_HTTP_SHUTDOWN_TIMEOUT=10s
AEP_GATEWAY_HTTP_MAX_HEADER_BYTES=1048576
