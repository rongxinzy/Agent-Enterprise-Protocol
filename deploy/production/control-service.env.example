# Non-secret production settings
AEP_ENVIRONMENT=production
AEP_LOG_FORMAT=json
AEP_LOG_LEVEL=info
AEP_ADDRESS=:8080
AEP_ISSUER=https://aep.example.com
AEP_MINIO_ENDPOINT=minio.example.internal:9000
AEP_MINIO_BUCKET=aep-skills
AEP_MINIO_SECURE=true
AEP_ACCESS_TTL=15m
AEP_MODEL_ACCESS_TTL=15m
AEP_REFRESH_TTL=720h
AEP_HTTP_READ_HEADER_TIMEOUT=5s
AEP_HTTP_READ_TIMEOUT=15s
AEP_HTTP_WRITE_TIMEOUT=30s
AEP_HTTP_IDLE_TIMEOUT=60s
AEP_HTTP_SHUTDOWN_TIMEOUT=10s
AEP_HTTP_MAX_HEADER_BYTES=1048576

# Mount these paths from the orchestrator's Secret provider.
AEP_DATABASE_URL_FILE=/run/secrets/aep-database-url
AEP_MINIO_ACCESS_KEY_FILE=/run/secrets/aep-minio-access-key
AEP_MINIO_SECRET_KEY_FILE=/run/secrets/aep-minio-secret-key
AEP_SIGNING_KEY_BASE64_FILE=/run/secrets/aep-ed25519-seed
AEP_CREDENTIAL_MASTER_KEY_FILE=/run/secrets/aep-credential-keyring
AEP_BOOTSTRAP_ADMIN_PASSWORD_FILE=/run/secrets/aep-bootstrap-admin-password

AEP_BOOTSTRAP_ENTERPRISE_ID=enterprise
AEP_BOOTSTRAP_ENTERPRISE_NAME=Enterprise
AEP_BOOTSTRAP_ADMIN_USERNAME=admin
AEP_BOOTSTRAP_ADMIN_DISPLAY_NAME=AEP Administrator
